<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1</TargetFrameworks>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETStandard'">
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>MulticastFunc</PackageId>
		<Version>2.0.1</Version>
		<Authors>ent3m</Authors>
		<Title>MulticastFunc</Title>
		<Description>A high-performance, drop-in alternative to Func that retrieves the return values of all invocations instead of only the final one.</Description>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<PackageProjectUrl>https://github.com/ent3m/MulticastFunc</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ent3m/MulticastFunc</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageReadmeFile>README-NUGET.md</PackageReadmeFile>
		<PackageTags>delegate;multicast;performance</PackageTags>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<PackageReleaseNotes>Add XML documentations.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README-NUGET.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
